# Local development only. Generate independent credentials for staging/production.
DATABASE_URL=postgresql://junta:junta_local@localhost:55432/junta?schema=public
TEST_DATABASE_URL=postgresql://junta:junta_local@localhost:55432/junta_test?schema=public
REDIS_URL=redis://localhost:16379
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PROXY_SHARED_SECRET=
# Only exact socket peers controlled by your ingress; never a wildcard.
TRUSTED_INGRESS_IPS=
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:8081
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api
API_SERVER_URL=http://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:4000
# Required to seed local accounts, never used in production
DEMO_PASSWORD=
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
FACEBOOK_APP_ID=
# Server only. Never expose this as NEXT_PUBLIC_ or EXPO_PUBLIC_.
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v25.0
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=
NEXT_PUBLIC_FACEBOOK_APP_ID=
NEXT_PUBLIC_FACEBOOK_GRAPH_VERSION=v25.0
NEXT_PUBLIC_APP_DOWNLOAD_URL=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
EXPO_PUBLIC_APPLE_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_APP_ID=
EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=
EXPO_PUBLIC_WEB_URL=http://localhost:3000
EAS_PROJECT_ID=
EXPO_ACCESS_TOKEN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
PUSH_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=51025
