generator client {
  provider = "prisma-client-js"
  output = "../generated/client"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  CONSUMER
  MERCHANT
  ANALYST
  ADMIN
}
enum Horizon {
  WEEK
  MONTH
  ANYTIME
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String?
  role Role @default(CONSUMER)
  providerSubject String? @unique
  referralCode String @unique @default(cuid())
  referredBy String?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  sessions Session[]
  intents PurchaseIntent[]
  memberships Membership[]
  devices Device[]
  notifications Notification[]
  preferences Json @default("{\"offers\":true,\"priceAlerts\":true,\"campaigns\":true,\"marketing\":false}")
}
model Session {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id])
  tokenHash String @unique
  family String
  expiresAt DateTime
  revokedAt DateTime?
  rotatedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, family])
}
model PasswordReset {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
}
model Product {
  id String @id @default(cuid())
  name String
  normalizedName String @unique
  slug String @unique
  description String
  category String
  illustration String @default("console")
  imageUrl String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  variants ProductVariant[]
  @@index([active,category])
}
model ProductVariant {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields:[productId], references:[id])
  name String
  demoPrice Decimal @db.Decimal(12,2)
  intents PurchaseIntent[]
  pools DemandPool[]
  offers Offer[]
  campaigns Campaign[]
  @@unique([productId,name])
}
model PurchaseIntent {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id])
  variantId String
  variant ProductVariant @relation(fields:[variantId],references:[id])
  horizon Horizon
  targetPrice Decimal @db.Decimal(12,2)
  active Boolean @default(true)
  idempotencyKey String
  createdAt DateTime @default(now())
  cancelledAt DateTime?
  @@unique([userId,idempotencyKey])
  @@index([variantId,horizon,active])
  @@index([userId,active])
}
model DemandPool {
  id String @id @default(cuid())
  variantId String
  variant ProductVariant @relation(fields:[variantId], references:[id])
  horizon Horizon
  count Int @default(0)
  targetTotal Decimal @default(0) @db.Decimal(16,2)
  updatedAt DateTime @updatedAt
  @@unique([variantId,horizon])
}
model Merchant {
  id String @id @default(cuid())
  name String
  approved Boolean @default(false)
  memberships Membership[]
  offers Offer[]
}
model Membership {
  userId String
  merchantId String
  user User @relation(fields:[userId],references:[id])
  merchant Merchant @relation(fields:[merchantId],references:[id])
  @@id([userId,merchantId])
}
model Offer {
  id String @id @default(cuid())
  variantId String
  variant ProductVariant @relation(fields:[variantId],references:[id])
  merchantId String
  merchant Merchant @relation(fields:[merchantId],references:[id])
  price Decimal @db.Decimal(12,2)
  url String
  startsAt DateTime
  endsAt DateTime
  active Boolean @default(true)
  createdAt DateTime @default(now())
  @@index([variantId,active,endsAt])
  @@index([merchantId,createdAt])
}
model Campaign {
  id String @id @default(cuid())
  variantId String
  variant ProductVariant @relation(fields:[variantId],references:[id])
  name String
  threshold Int
  startsAt DateTime
  endsAt DateTime
  createdAt DateTime @default(now())
}
model OutboxEvent {
  id String @id @default(cuid())
  type String
  eventVersion Int @default(1)
  payload Json
  attempts Int @default(0)
  availableAt DateTime @default(now())
  processedAt DateTime?
  deadAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  @@index([processedAt,deadAt,availableAt])
}
model Notification {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId], references:[id])
  eventId String
  offerId String?
  title String
  body String
  readAt DateTime?
  createdAt DateTime @default(now())
  @@unique([userId,eventId])
  @@index([userId,createdAt])
}
model Device {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id])
  token String @unique
  platform String
  enabled Boolean @default(true)
  lastSeenAt DateTime @default(now())
}
model AuditLog {
  id String @id @default(cuid())
  actorId String
  action String
  resourceId String
  createdAt DateTime @default(now())
  @@index([actorId,createdAt])
}
model AnalyticsEvent {
  id String @id @default(cuid())
  userId String?
  name String
  properties Json
  createdAt DateTime @default(now())
  @@index([name,createdAt])
}
model ReferralVisit {
  id String @id @default(cuid())
  code String
  productSlug String?
  createdAt DateTime @default(now())
  @@index([code])
}
model RemoteConfig {
  key String @id
  value Json
}
