{
  "name": "@junta/api", "private": true, "version": "0.1.0",
  "scripts": {
    "dev": "dotenv -e ../../.env -o -- tsx watch src/main.ts", "build": "prisma generate && tsc -p tsconfig.json", "typecheck": "tsc --noEmit",
    "start": "node dist/main.js", "worker": "dotenv -e ../../.env -o -- tsx src/worker.ts",
    "test": "dotenv -e ../../.env -o -- tsx --test --test-concurrency=1 test/*.test.ts",
    "db:generate": "prisma generate", "db:migrate": "dotenv -e ../../.env -o -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -o -- tsx prisma/seed.ts",
    "db:reset": "dotenv -e ../../.env -o -- prisma migrate reset"
  },
  "dependencies": {"@junta/validation": "workspace:*", "@nestjs/common": "^11.2.9", "@nestjs/core": "^11.2.9", "@nestjs/platform-express": "^11.2.9", "@nestjs/swagger": "^11.2.0", "@prisma/client": "6.19.3", "argon2": "^0.44.0", "bullmq": "^5.63.0", "cookie-parser": "^1.4.7", "helmet": "^8.1.0", "ioredis": "^5.8.2", "jose": "^6.1.0", "jsonwebtoken": "^9.0.2", "nodemailer": "^7.0.10", "reflect-metadata": "^0.2.2", "rxjs": "^7.8.2", "zod": "^4.1.0"},
  "devDependencies": {"prisma": "6.19.3", "@types/express": "^5.0.5", "@types/cookie-parser": "^1.4.9", "@types/jsonwebtoken": "^9.0.10", "@types/nodemailer": "^7.0.3"}
}
