{
  "name": "junta",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "dotenv -e .env -o -- turbo dev",
    "build": "turbo build",
    "lint": "eslint .",
    "typecheck": "turbo typecheck",
    "test": "pnpm --filter @junta/validation build && pnpm --filter @junta/validation test && pnpm --filter @junta/api-client test && pnpm --filter @junta/api test",
    "test:e2e": "pnpm --filter @junta/api-client build && dotenv -e .env -o -- playwright test",
    "api:generate": "pnpm --filter @junta/api exec dotenv -e ../../.env -o -- tsx scripts/openapi.ts && openapi-typescript packages/api-client/openapi.json -o packages/api-client/src/generated.ts",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @junta/api db:generate",
    "db:migrate": "pnpm --filter @junta/api db:migrate",
    "db:seed": "pnpm --filter @junta/api db:seed",
    "db:reset": "pnpm --filter @junta/api db:reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "typescript": "~5.9.3",
    "@types/node": "^22.19.0",
    "prettier": "^3.6.2",
    "turbo": "^2.6.0",
    "tsx": "^4.20.6",
    "@playwright/test": "^1.56.1",
    "dotenv-cli": "^10.0.0",
    "openapi-typescript": "^7.10.1"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.0",
      "decode-uri-component": "0.5.1",
      "zod@3.25.76": "4.6.6",
      "glob@13.0.7": "14.0.2",
      "minimatch@10.2.6": "11.0.1"
    }
  }
}
